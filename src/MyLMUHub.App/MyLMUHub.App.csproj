<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MyLMUHub.App</RootNamespace>
    <!-- the exe is MyLMUHub.exe (the app's name); settings in %AppData%\MyLMUHub (the old LMUHub / mylmu / LmuPitwall folder is moved there once, Settings.cs) -->
    <AssemblyName>MyLMUHub</AssemblyName>
    <!-- the app version (shown in the hub): version.txt = the next version release.ps1 publishes -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\..\version.txt').Trim())</Version>
    <StartupObject>MyLMUHub.App.Program</StartupObject>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- exe icon (Explorer / desktop); the same file is the window icon (title bar / taskbar), see MainWindow. Source: assets\app-icon\MyLMUHub.ico -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>
  <ItemGroup Condition="'$(UpdateRepo)' != ''">
    <!-- release builds only (release.ps1 -p:UpdateRepo=owner/name): the public GitHub repo the update check reads (UpdateService); dev builds have none -->
    <AssemblyMetadata Include="UpdateRepo" Value="$(UpdateRepo)" />
  </ItemGroup>
  <ItemGroup>
    <!-- the dashboard window is a web page rendered by WebView2 (the Edge engine; preinstalled on Windows 11 and most Windows 10) -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MyLMUHub.Core\MyLMUHub.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
